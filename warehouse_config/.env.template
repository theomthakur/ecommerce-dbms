"""Environment variables template for warehouse configuration"""

# PostgreSQL
export DBT_HOST="localhost"
export DBT_USER="postgres"
export DBT_PASSWORD="postgres"
export DBT_PORT="5432"
export DBT_DBNAME="ecommerce_dw"

# BigQuery
export GCP_PROJECT_ID="your-project-id"
export BIGQUERY_DATASET="ecommerce_dw"
export GCP_CREDENTIALS_PATH="/path/to/service-account-key.json"

# Redshift
export REDSHIFT_HOST="your-cluster.region.redshift.amazonaws.com"
export REDSHIFT_USER="admin"
export REDSHIFT_PASSWORD="your_password"
export REDSHIFT_PORT="5439"
export REDSHIFT_DBNAME="ecommerce_dw"
export REDSHIFT_SCHEMA="public"

# Airflow
export AIRFLOW_HOME="/path/to/airflow"
export AIRFLOW__CORE__DAGS_FOLDER="/path/to/airflow/dags"
export AIRFLOW__CORE__EXECUTOR="LocalExecutor"

# dbt
export DBT_PROFILES_DIR="/path/to/dbt/profiles"
